{
  "name": "agentshore-desktop",
  "private": true,
  "version": "0.11.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix ../dashboard run build:lib",
    "build": "tsc && vite build",
    "prepare:tauri-assets": "node scripts/prepare-tauri-assets.mjs",
    "prebuild:tauri-frontend": "npm --prefix ../dashboard run build:lib",
    "build:tauri-frontend": "npm run build && npm run prepare:tauri-assets",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretest": "npm --prefix ../dashboard run build:lib",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentshore/dashboard": "*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-updater": "2.14.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
